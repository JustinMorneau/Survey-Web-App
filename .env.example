# Copy this file to .env.local and fill in your values.
# .env.local is ignored by git (the Vite template ignores *.local). Never commit it.

# Supabase: Project Settings -> API (or "API Keys")
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public key: labelled "publishable" or "anon public" in the dashboard. Never use a secret/service_role key here.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Base URL used in QR codes (D12). Leave empty locally to use the current browser origin.
# In production set it to your Cloudflare Pages URL, e.g. https://classroom-survey.pages.dev
VITE_PUBLIC_SITE_URL=
